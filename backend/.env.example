# ExamAI backend environment template.
# Copy this file to .env.local for local development. Never commit real secrets.

APP_ENV=local
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173

# Supabase: Project Settings -> API, Connect, and Storage.
SUPABASE_URL=TODO_SET_SUPABASE_PROJECT_URL
SUPABASE_ANON_KEY=TODO_SET_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=TODO_SET_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=TODO_SET_SUPABASE_DATABASE_URL
SUPABASE_STORAGE_BUCKET=TODO_SET_PRIVATE_STORAGE_BUCKET_NAME

# Qdrant Cloud: use the HTTPS cluster endpoint and an API key.
QDRANT_URL=TODO_SET_QDRANT_HTTPS_URL
QDRANT_API_KEY=TODO_SET_QDRANT_API_KEY
QDRANT_COLLECTION=exam_materials
QDRANT_TIMEOUT_SECONDS=60

# Local dense embeddings.
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5

# Gemini: verify this against the models endpoint before setting it.
# Do not assume gemini-1.5-flash is available.
GEMINI_API_KEY=TODO_SET_GEMINI_API_KEY
GEMINI_MODEL=TODO_VERIFY_WITH_MODELS_ENDPOINT

# Verify a model name with:
# curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" \
#   | jq -r '.models[] | select(.supportedGenerationMethods[]? == "generateContent") | .name'
# Set GEMINI_MODEL to the returned name without the "models/" prefix.
